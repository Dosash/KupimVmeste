[Unit]
Description=Verified hot local backup of KupimVmeste SQLite database
After=shopping-list-bot.service

[Service]
Type=oneshot
TimeoutStartSec=5min
DynamicUser=yes
User=shopping-list-bot
Group=shopping-list-bot
StateDirectory=shopping-list-bot
StateDirectoryMode=0700
WorkingDirectory=/opt/shopping-list-bot
ExecStart=/opt/shopping-list-bot/.venv/bin/python -m app.backup --database /var/lib/shopping-list-bot/shopping_list.sqlite3 --backup-dir /var/lib/shopping-list-bot/backups --keep 30
UMask=0077

NoNewPrivileges=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
MemoryMax=128M
TasksMax=32
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
